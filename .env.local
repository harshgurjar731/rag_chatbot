# Localhost Configuration for Hybrid Setup

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=chatbot_db

# Ingestion Pool (port 8001 is taken by ChromaDB in Docker)
INGESTION_POOL_PORT=8003

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ChromaDB
CHROMA_SERVER_HOST=localhost
CHROMA_SERVER_PORT=8001

# Phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PORT=6006
PHOENIX_GRPC_PORT=4317

# Backend
BACKEND_BASE_URL=http://localhost:8000
PROJECT_ROOT=..

# Worker Pool
WORKER_POOL_SIZE=5

# API Keys (Placeholders - User should update these if needed, or they will be loaded from system env if present)
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# AZURE_API_KEY=
