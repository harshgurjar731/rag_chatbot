# =============================================================================
# INPUT RAILS
# =============================================================================

# 1. JAILBREAK CHECK (GROQ)
# Matches config: - check jailbreak groq
define flow check jailbreak groq
  $is_jailbreak = execute check_jailbreak_groq
  if $is_jailbreak
    bot inform jailbreak attempt
    stop

# 2. JAILBREAK CHECK (NVIDIA)
# Matches config: - jailbreak detection model
define flow jailbreak detection model
  $is_jailbreak = execute jailbreak_detection_model
  if $is_jailbreak
    bot inform jailbreak attempt
    stop

# 3. SELF CHECK INPUT
# Matches config: - self check input
define flow self check input
  $allowed = execute self_check_input
  if not $allowed
    bot refuse to respond
    stop

# 4. CONTENT SAFETY (GROQ)
# Matches config: - check content safety groq
define flow check content safety groq
  $safety_status = execute check_content_safety_groq
  if $safety_status == "unsafe"
    bot refuse to respond
    stop

# 5. CONTENT SAFETY (NVIDIA)
# Matches config: - content safety check input $model=content_safety
define bot refuse content safety
  "BLOCKED: CONTENT_SAFETY"


# 5. CONTENT SAFETY (NVIDIA)
# In rails.co
# In rails.co
define bot say safety block
  "{{ block_message }}"

# =============================================================================
# UPDATE THE FLOW
# =============================================================================

# 5. CONTENT SAFETY (NVIDIA)
define flow content safety check input
  $safety_result = execute content_safety_check_input(model="content_safety")
  
  if not $safety_result.allowed
    # 1. Get the string from Python
    $block_message = execute format_safety_violation(data=$safety_result)
    
    # 2. FIX: Use the specific defined response.
    # This bypasses the LLM generation phase entirely.
    bot say safety block
    
    stop

# 6. TOPIC CONTROL
# Matches config: - topic control check
define flow topic control check
  $topic_check_result = execute topic_control_check
  if $topic_check_result == "off-topic"
    bot inform off topic
    stop

# =============================================================================
# OUTPUT RAILS
# =============================================================================

# 7. SELF CHECK OUTPUT
# Matches config: - self check output
define flow self check output
  $allowed = execute self_check_output
  if not $allowed
    bot refuse to respond
    stop

# 8. CONTENT SAFETY OUTPUT (NVIDIA)
# Matches config: - content safety check output $model=content_safety
define flow content safety check output
  $allowed = execute content_safety_check_output(model="content_safety")
  if not $allowed
    bot refuse to respond
    stop

# 9. CONTENT SAFETY OUTPUT (GROQ)
# Matches config: - check content safety output groq
# NOTE: We use a specific output action here to check 'bot_message'
define flow check content safety output groq
  $safety_status = execute check_content_safety_output_groq
  if $safety_status == "unsafe"
    bot refuse to respond
    stop

# =============================================================================
# BOT RESPONSES & USER INTENTS
# =============================================================================

define bot inform jailbreak attempt
  "Jailbreak Attempt."

define bot refuse to respond 
  "I cannot answer that request due to safety guidelines."

define bot inform off topic
  "I am a medical-purpose assistant. That topic is outside my permitted scope or violates my safety guidelines."

define bot respond to greeting
  "Hello! I am your general assistant. How can I help you today?"

define flow general conversation
  user ask general question
  bot respond
  stop

define flow user greeting
  user greet
  bot respond to greeting
  stop

define user greet
  "Hi"
  "Hello"
  "Hey"
  "Greetings"

define user ask general question
  "Tell me a joke"
  "What is the weather?"
  "Write code"
  "Who are you?"